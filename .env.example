# Use a newly rotated Neon password. Keep real credentials in .env.local / deployment secrets.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Protects the admin-only question and content ingestion endpoints. Use a long random secret.
ADMIN_IMPORT_TOKEN="replace-with-a-long-random-secret"
